{
  "name": "sbgpu-control",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "assets": {
    "directory": "../ui/dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "sbgpu-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "MACHINE_RELAY", "class_name": "MachineRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineRelay"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://gpu.example.com",
    "MACHINE_DOMAIN": "machines.example.com",
    "WORKOS_CLIENT_ID": "client_00000000000000000000000000",
    "WORKOS_ISSUER": "https://api.workos.com/user_management/client_00000000000000000000000000",
    "WORKOS_JWKS_URL": "https://api.workos.com/sso/jwks/client_00000000000000000000000000"
  }
}
